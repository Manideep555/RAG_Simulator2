<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>RAG Simulator</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet"/>
<style>
:root {
  --bg: #080c14;
  --surface: #0e1420;
  --surface2: #141a28;
  --border: #1e2a3e;
  --accent: #00d4ff;
  --accent2: #7c3aed;
  --accent3: #10b981;
  --warn: #f59e0b;
  --danger: #ef4444;
  --text: #e2e8f0;
  --muted: #64748b;
  --dim: #334155;
  --glow: 0 0 20px rgba(0,212,255,0.25);
  --glow2: 0 0 20px rgba(124,58,237,0.25);
}

*{margin:0;padding:0;box-sizing:border-box;}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Syne', sans-serif;
  min-height: 100vh;
  overflow-x: hidden;
}

/* Animated bg grid */
body::before {
  content:'';
  position:fixed;
  inset:0;
  background-image:
    linear-gradient(rgba(0,212,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,212,255,0.03) 1px, transparent 1px);
  background-size:40px 40px;
  pointer-events:none;
  z-index:0;
}

.container { position:relative; z-index:1; max-width:1100px; margin:0 auto; padding:0 20px 60px; }

/* Header */
header {
  text-align:center;
  padding:48px 20px 32px;
  position:relative;
}
.header-badge {
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:rgba(0,212,255,0.08);
  border:1px solid rgba(0,212,255,0.2);
  border-radius:999px;
  padding:6px 16px;
  font-family:'Space Mono',monospace;
  font-size:11px;
  color:var(--accent);
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:20px;
}
.pulse-dot {
  width:6px;height:6px;border-radius:50%;
  background:var(--accent);
  animation:pulse 2s infinite;
}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.5;transform:scale(1.4);}}

h1 {
  font-size:clamp(36px, 6vw, 64px);
  font-weight:800;
  letter-spacing:-2px;
  background: linear-gradient(135deg, #fff 0%, var(--accent) 50%, var(--accent2) 100%);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
  line-height:1.05;
  margin-bottom:12px;
}
.subtitle {
  color:var(--muted);
  font-family:'Space Mono',monospace;
  font-size:13px;
  letter-spacing:1px;
}

/* Step nav */
.step-nav {
  display:flex;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
  gap:4px;
  margin:32px 0;
  padding:16px;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:16px;
}
.step-pill {
  display:flex;
  align-items:center;
  gap:6px;
  padding:6px 12px;
  border-radius:8px;
  font-size:11px;
  font-family:'Space Mono',monospace;
  cursor:pointer;
  transition:all 0.2s;
  border:1px solid transparent;
  color:var(--muted);
  white-space:nowrap;
}
.step-pill.done { color:var(--accent3); border-color:rgba(16,185,129,0.3); background:rgba(16,185,129,0.06); }
.step-pill.active { color:var(--accent); border-color:rgba(0,212,255,0.4); background:rgba(0,212,255,0.08); box-shadow:var(--glow); }
.step-pill .num {
  width:18px;height:18px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:9px;font-weight:700;
  background:var(--dim);
  color:var(--muted);
  flex-shrink:0;
}
.step-pill.done .num { background:var(--accent3); color:#000; }
.step-pill.active .num { background:var(--accent); color:#000; }
.sep { color:var(--dim); font-size:10px; padding:0 2px; }

/* Cards */
.card {
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:20px;
  padding:32px;
  margin-bottom:20px;
  position:relative;
  overflow:hidden;
  display:none;
  animation:fadeUp 0.4s ease forwards;
}
.card.active { display:block; }
@keyframes fadeUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}

.card::before {
  content:'';
  position:absolute;
  top:0;left:0;right:0;
  height:2px;
  background:linear-gradient(90deg, var(--accent), var(--accent2));
  opacity:0;
  transition:opacity 0.3s;
}
.card.active::before { opacity:1; }

.card-header {
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  margin-bottom:24px;
  gap:16px;
}
.card-title-block { flex:1; }
.card-phase {
  font-family:'Space Mono',monospace;
  font-size:10px;
  letter-spacing:2px;
  text-transform:uppercase;
  color:var(--muted);
  margin-bottom:6px;
}
.card-title {
  font-size:22px;
  font-weight:700;
  color:#fff;
  margin-bottom:4px;
}
.card-desc {
  font-size:13px;
  color:var(--muted);
  font-family:'Space Mono',monospace;
}
.step-badge {
  background:rgba(0,212,255,0.1);
  border:1px solid rgba(0,212,255,0.2);
  border-radius:8px;
  padding:8px 12px;
  text-align:center;
  flex-shrink:0;
}
.step-badge .step-num {
  font-family:'Space Mono',monospace;
  font-size:18px;
  font-weight:700;
  color:var(--accent);
  line-height:1;
}
.step-badge .step-total {
  font-family:'Space Mono',monospace;
  font-size:10px;
  color:var(--muted);
}

/* Inputs & Textareas */
textarea, input[type=text], input[type=number] {
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:10px;
  color:var(--text);
  font-family:'Space Mono',monospace;
  font-size:13px;
  padding:12px 14px;
  width:100%;
  resize:vertical;
  transition:border-color 0.2s, box-shadow 0.2s;
  outline:none;
}
textarea:focus, input[type=text]:focus, input[type=number]:focus {
  border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(0,212,255,0.1);
}
textarea { min-height:90px; }

label {
  display:block;
  font-family:'Space Mono',monospace;
  font-size:11px;
  color:var(--muted);
  letter-spacing:1px;
  text-transform:uppercase;
  margin-bottom:8px;
}

/* Buttons */
.btn {
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:12px 24px;
  border-radius:10px;
  font-family:'Syne',sans-serif;
  font-weight:700;
  font-size:14px;
  cursor:pointer;
  border:none;
  transition:all 0.2s;
  position:relative;
  overflow:hidden;
}
.btn::after {
  content:'';
  position:absolute;
  inset:0;
  background:rgba(255,255,255,0);
  transition:background 0.2s;
}
.btn:hover::after { background:rgba(255,255,255,0.08); }

.btn-primary {
  background:linear-gradient(135deg,var(--accent),#0099cc);
  color:#000;
  box-shadow:0 4px 20px rgba(0,212,255,0.3);
}
.btn-primary:hover { box-shadow:0 6px 28px rgba(0,212,255,0.5); transform:translateY(-1px); }

.btn-secondary {
  background:var(--surface2);
  color:var(--text);
  border:1px solid var(--border);
}
.btn-secondary:hover { border-color:var(--accent); color:var(--accent); }

.btn-ghost {
  background:transparent;
  color:var(--muted);
  border:1px solid var(--dim);
  padding:8px 16px;
  font-size:12px;
}
.btn-ghost:hover { color:var(--text); border-color:var(--muted); }

.btn-danger {
  background:rgba(239,68,68,0.1);
  color:var(--danger);
  border:1px solid rgba(239,68,68,0.2);
  font-size:12px;
  padding:6px 12px;
}
.btn-danger:hover { background:rgba(239,68,68,0.2); }

.btn-actions {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:28px;
  gap:12px;
  flex-wrap:wrap;
}

/* Document list */
.doc-list { display:flex; flex-direction:column; gap:10px; margin-bottom:16px; }
.doc-item {
  display:flex;
  align-items:flex-start;
  gap:12px;
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:10px;
  padding:12px 14px;
  transition:border-color 0.2s;
}
.doc-item:hover { border-color:var(--dim); }
.doc-icon {
  width:32px;height:32px;
  background:rgba(0,212,255,0.1);
  border:1px solid rgba(0,212,255,0.2);
  border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  font-size:14px;
  flex-shrink:0;
  margin-top:2px;
}
.doc-text {
  flex:1;
  font-family:'Space Mono',monospace;
  font-size:12px;
  color:var(--text);
  line-height:1.6;
}
.add-doc-row {
  display:flex;
  gap:10px;
  align-items:flex-start;
  margin-bottom:16px;
}
.add-doc-row textarea { min-height:70px; flex:1; }

/* Chunks grid */
.chunks-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:12px; margin-bottom:16px; }
.chunk-card {
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:10px;
  padding:14px;
  transition:all 0.2s;
  position:relative;
}
.chunk-card.highlighted {
  border-color:var(--accent);
  background:rgba(0,212,255,0.05);
  box-shadow:var(--glow);
}
.chunk-id {
  font-family:'Space Mono',monospace;
  font-size:9px;
  color:var(--muted);
  letter-spacing:1px;
  margin-bottom:6px;
}
.chunk-text {
  font-family:'Space Mono',monospace;
  font-size:11px;
  color:var(--text);
  line-height:1.6;
}
.chunk-source {
  font-size:9px;
  color:var(--dim);
  font-family:'Space Mono',monospace;
  margin-top:6px;
}

/* Slider */
.slider-row { display:flex; flex-direction:column; gap:20px; margin-bottom:20px; }
.slider-group label { margin-bottom:4px; }
.slider-val {
  font-family:'Space Mono',monospace;
  font-size:20px;
  font-weight:700;
  color:var(--accent);
  float:right;
}
input[type=range] {
  -webkit-appearance:none;
  width:100%;
  height:4px;
  background:var(--dim);
  border-radius:2px;
  outline:none;
  margin-top:8px;
}
input[type=range]::-webkit-slider-thumb {
  -webkit-appearance:none;
  width:18px;height:18px;
  border-radius:50%;
  background:var(--accent);
  cursor:pointer;
  box-shadow:0 0 10px rgba(0,212,255,0.5);
}

/* Vector viz */
.vector-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:12px;
  margin-bottom:16px;
}
.vector-card {
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:10px;
  padding:14px;
}
.vector-label {
  font-family:'Space Mono',monospace;
  font-size:10px;
  color:var(--muted);
  margin-bottom:10px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.vector-bars { display:flex; gap:2px; height:36px; align-items:flex-end; }
.vector-bar {
  flex:1;
  border-radius:2px 2px 0 0;
  min-height:2px;
  transition:height 0.4s ease;
}

/* Similarity bars */
.sim-list { display:flex; flex-direction:column; gap:10px; margin-bottom:16px; }
.sim-item {
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:10px;
  padding:14px;
  transition:all 0.2s;
}
.sim-item.selected { border-color:var(--accent3); background:rgba(16,185,129,0.05); }
.sim-header {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:8px;
}
.sim-chunk { font-family:'Space Mono',monospace; font-size:11px; color:var(--text); }
.sim-score {
  font-family:'Space Mono',monospace;
  font-size:13px;
  font-weight:700;
  color:var(--accent);
}
.sim-item.selected .sim-score { color:var(--accent3); }
.sim-bar-bg {
  height:4px;
  background:var(--dim);
  border-radius:2px;
  overflow:hidden;
}
.sim-bar-fill {
  height:100%;
  border-radius:2px;
  background:linear-gradient(90deg,var(--accent2),var(--accent));
  transition:width 0.8s cubic-bezier(0.4,0,0.2,1);
}
.sim-item.selected .sim-bar-fill { background:linear-gradient(90deg,var(--accent3),#34d399); }
.topk-badge {
  display:inline-flex;
  align-items:center;
  gap:4px;
  background:rgba(16,185,129,0.1);
  border:1px solid rgba(16,185,129,0.3);
  border-radius:4px;
  padding:2px 7px;
  font-family:'Space Mono',monospace;
  font-size:9px;
  color:var(--accent3);
  margin-left:6px;
}

/* Prompt display */
.prompt-box {
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:12px;
  overflow:hidden;
  margin-bottom:16px;
}
.prompt-section {
  padding:14px 16px;
  border-bottom:1px solid var(--border);
}
.prompt-section:last-child { border-bottom:none; }
.prompt-section-label {
  font-family:'Space Mono',monospace;
  font-size:9px;
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:8px;
  display:flex;
  align-items:center;
  gap:6px;
}
.prompt-section-label.context { color:var(--accent2); }
.prompt-section-label.query { color:var(--accent); }
.prompt-section-label.instruction { color:var(--warn); }
.prompt-text {
  font-family:'Space Mono',monospace;
  font-size:12px;
  line-height:1.7;
  color:var(--text);
}

/* LLM Response */
.response-box {
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:12px;
  padding:20px;
  margin-bottom:16px;
  position:relative;
  overflow:hidden;
}
.response-box::before {
  content:'';
  position:absolute;
  top:0;left:0;bottom:0;
  width:3px;
  background:linear-gradient(180deg,var(--accent3),var(--accent));
}
.response-text {
  font-size:14px;
  line-height:1.8;
  color:var(--text);
  padding-left:8px;
}
.response-text .citation {
  display:inline-flex;
  align-items:center;
  background:rgba(0,212,255,0.1);
  border:1px solid rgba(0,212,255,0.2);
  border-radius:4px;
  padding:1px 6px;
  font-family:'Space Mono',monospace;
  font-size:10px;
  color:var(--accent);
  margin:0 2px;
  cursor:pointer;
  transition:background 0.2s;
}
.response-text .citation:hover { background:rgba(0,212,255,0.2); }

.typing-cursor {
  display:inline-block;
  width:2px;height:16px;
  background:var(--accent);
  border-radius:1px;
  animation:blink 1s infinite;
  margin-left:2px;
  vertical-align:middle;
}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0;}}

/* Stats bar */
.stats-bar {
  display:flex;
  align-items:center;
  gap:24px;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:12px;
  padding:16px 20px;
  margin-bottom:20px;
  flex-wrap:wrap;
}
.stat-item { display:flex;align-items:center;gap:8px; }
.stat-label {
  font-family:'Space Mono',monospace;
  font-size:10px;
  color:var(--muted);
  letter-spacing:1px;
}
.stat-val {
  font-family:'Space Mono',monospace;
  font-size:14px;
  font-weight:700;
  color:var(--accent);
}
.stat-div { width:1px;height:24px;background:var(--border); }

/* Pipeline flow */
.pipeline {
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:16px;
  padding:24px;
  margin-bottom:20px;
  overflow-x:auto;
}
.pipeline-title {
  font-family:'Space Mono',monospace;
  font-size:10px;
  letter-spacing:2px;
  color:var(--muted);
  text-transform:uppercase;
  margin-bottom:16px;
}
.pipeline-flow {
  display:flex;
  align-items:center;
  gap:0;
  min-width:600px;
}
.flow-node {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:6px;
  flex:1;
}
.flow-icon {
  width:44px;height:44px;
  border-radius:12px;
  border:1px solid var(--border);
  background:var(--surface2);
  display:flex;align-items:center;justify-content:center;
  font-size:18px;
  transition:all 0.3s;
  position:relative;
}
.flow-node.done .flow-icon { border-color:var(--accent3); background:rgba(16,185,129,0.1); box-shadow:0 0 12px rgba(16,185,129,0.2); }
.flow-node.active .flow-icon { border-color:var(--accent); background:rgba(0,212,255,0.1); box-shadow:var(--glow); animation:nodePulse 2s infinite; }
@keyframes nodePulse{0%,100%{box-shadow:0 0 12px rgba(0,212,255,0.3);}50%{box-shadow:0 0 24px rgba(0,212,255,0.6);}}
.flow-label {
  font-family:'Space Mono',monospace;
  font-size:9px;
  color:var(--muted);
  text-align:center;
  letter-spacing:0.5px;
}
.flow-node.done .flow-label { color:var(--accent3); }
.flow-node.active .flow-label { color:var(--accent); }
.flow-arrow {
  color:var(--dim);
  font-size:16px;
  padding:0 4px;
  flex-shrink:0;
  margin-bottom:20px;
}

/* Sample queries */
.sample-pills { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
.sample-pill {
  padding:6px 14px;
  border-radius:999px;
  font-family:'Space Mono',monospace;
  font-size:11px;
  background:var(--surface2);
  border:1px solid var(--border);
  color:var(--muted);
  cursor:pointer;
  transition:all 0.2s;
}
.sample-pill:hover { border-color:var(--accent); color:var(--accent); background:rgba(0,212,255,0.05); }

/* Info tag */
.info-tag {
  display:inline-flex;
  align-items:center;
  gap:6px;
  background:rgba(245,158,11,0.08);
  border:1px solid rgba(245,158,11,0.2);
  border-radius:8px;
  padding:8px 12px;
  font-family:'Space Mono',monospace;
  font-size:11px;
  color:var(--warn);
  margin-bottom:16px;
}

/* Loading spinner */
.spinner {
  width:16px;height:16px;
  border:2px solid var(--dim);
  border-top-color:var(--accent);
  border-radius:50%;
  animation:spin 0.8s linear infinite;
  flex-shrink:0;
}
@keyframes spin{to{transform:rotate(360deg);}}

.hidden { display:none !important; }

/* Token display */
.token-list { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
.token {
  padding:4px 10px;
  border-radius:6px;
  font-family:'Space Mono',monospace;
  font-size:11px;
  background:rgba(124,58,237,0.1);
  border:1px solid rgba(124,58,237,0.25);
  color:#a78bfa;
}

/* Concept cards */
.concepts {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
  gap:12px;
  margin-top:24px;
}
.concept-card {
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:12px;
  padding:16px;
}
.concept-icon { font-size:20px; margin-bottom:8px; }
.concept-title { font-weight:700; font-size:14px; margin-bottom:4px; }
.concept-body { font-family:'Space Mono',monospace; font-size:11px; color:var(--muted); line-height:1.6; }

/* Success banner */
.success-banner {
  background:rgba(16,185,129,0.08);
  border:1px solid rgba(16,185,129,0.25);
  border-radius:12px;
  padding:16px 20px;
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:16px;
  font-family:'Space Mono',monospace;
  font-size:12px;
  color:var(--accent3);
}

/* Scrollbar */
::-webkit-scrollbar { width:6px; height:6px; }
::-webkit-scrollbar-track { background:var(--surface); }
::-webkit-scrollbar-thumb { background:var(--dim); border-radius:3px; }
::-webkit-scrollbar-thumb:hover { background:var(--muted); }
</style>
</head>
<body>

<div class="container">

  <!-- Header -->
  <header>
    <div class="header-badge"><span class="pulse-dot"></span>Interactive Demo</div>
    <h1>RAG Simulator</h1>
    <p class="subtitle">// Retrieval-Augmented Generation — step by step</p>
  </header>

  <!-- Stats Bar -->
  <div class="stats-bar">
    <div class="stat-item"><span class="stat-label">DOCS</span><span class="stat-val" id="statDocs">0</span></div>
    <div class="stat-div"></div>
    <div class="stat-item"><span class="stat-label">CHUNKS</span><span class="stat-val" id="statChunks">0</span></div>
    <div class="stat-div"></div>
    <div class="stat-item"><span class="stat-label">VECTOR DIMS</span><span class="stat-val">16</span></div>
    <div class="stat-div"></div>
    <div class="stat-item"><span class="stat-label">SIMILARITY</span><span class="stat-val">Cosine</span></div>
    <div class="stat-div"></div>
    <div class="stat-item"><span class="stat-label">TOP-K</span><span class="stat-val" id="statTopK">3</span></div>
    <div class="stat-div"></div>
    <div class="stat-item"><span class="stat-label">MODEL</span><span class="stat-val">LLM Demo</span></div>
  </div>

  <!-- Pipeline Viz -->
  <div class="pipeline">
    <div class="pipeline-title">// PIPELINE OVERVIEW</div>
    <div class="pipeline-flow" id="pipelineFlow">
      <div class="flow-node" data-step="0"><div class="flow-icon">📄</div><div class="flow-label">CORPUS</div></div>
      <div class="flow-arrow">→</div>
      <div class="flow-node" data-step="1"><div class="flow-icon">✂️</div><div class="flow-label">CHUNK</div></div>
      <div class="flow-arrow">→</div>
      <div class="flow-node" data-step="2"><div class="flow-icon">🔢</div><div class="flow-label">EMBED</div></div>
      <div class="flow-arrow">→</div>
      <div class="flow-node" data-step="3"><div class="flow-icon">🗄️</div><div class="flow-label">STORE</div></div>
      <div class="flow-arrow">→</div>
      <div class="flow-node" data-step="4"><div class="flow-icon">💬</div><div class="flow-label">QUERY</div></div>
      <div class="flow-arrow">→</div>
      <div class="flow-node" data-step="5"><div class="flow-icon">🔍</div><div class="flow-label">RETRIEVE</div></div>
      <div class="flow-arrow">→</div>
      <div class="flow-node" data-step="6"><div class="flow-icon">📝</div><div class="flow-label">AUGMENT</div></div>
      <div class="flow-arrow">→</div>
      <div class="flow-node" data-step="7"><div class="flow-icon">✨</div><div class="flow-label">GENERATE</div></div>
    </div>
  </div>

  <!-- Step Nav -->
  <div class="step-nav" id="stepNav">
    <div class="step-pill active" data-step="0" onclick="goToStep(0)"><span class="num">1</span>Corpus</div>
    <span class="sep">›</span>
    <div class="step-pill" data-step="1" onclick="goToStep(1)"><span class="num">2</span>Chunking</div>
    <span class="sep">›</span>
    <div class="step-pill" data-step="2" onclick="goToStep(2)"><span class="num">3</span>Embedding</div>
    <span class="sep">›</span>
    <div class="step-pill" data-step="3" onclick="goToStep(3)"><span class="num">4</span>Vector Store</div>
    <span class="sep">›</span>
    <div class="step-pill" data-step="4" onclick="goToStep(4)"><span class="num">5</span>Query</div>
    <span class="sep">›</span>
    <div class="step-pill" data-step="5" onclick="goToStep(5)"><span class="num">6</span>Retrieval</div>
    <span class="sep">›</span>
    <div class="step-pill" data-step="6" onclick="goToStep(6)"><span class="num">7</span>Augment</div>
    <span class="sep">›</span>
    <div class="step-pill" data-step="7" onclick="goToStep(7)"><span class="num">8</span>Generate</div>
  </div>

  <!-- STEP 1: Corpus -->
  <div class="card active" id="step-0">
    <div class="card-header">
      <div class="card-title-block">
        <div class="card-phase">01 / 08 · INGESTION PHASE</div>
        <div class="card-title">📄 Corpus / Knowledge Base</div>
        <div class="card-desc">// Raw documents that will power your AI</div>
      </div>
      <div class="step-badge"><div class="step-num">01</div><div class="step-total">of 08</div></div>
    </div>

    <label>Your Documents</label>
    <div class="doc-list" id="docList"></div>

    <div class="add-doc-row">
      <textarea id="newDocText" placeholder="Paste or type a new document here..."></textarea>
    </div>
    <button class="btn btn-secondary" onclick="addDoc()" style="margin-bottom:20px;">
      <span>+</span> Add Document
    </button>

    <div class="btn-actions">
      <div></div>
      <button class="btn btn-primary" onclick="nextStep(0)">✂️ Chunk Documents →</button>
    </div>
  </div>

  <!-- STEP 2: Chunking -->
  <div class="card" id="step-1">
    <div class="card-header">
      <div class="card-title-block">
        <div class="card-phase">02 / 08 · INGESTION PHASE</div>
        <div class="card-title">✂️ Chunking</div>
        <div class="card-desc">// Split documents into overlapping semantic pieces</div>
      </div>
      <div class="step-badge"><div class="step-num">02</div><div class="step-total">of 08</div></div>
    </div>

    <div class="slider-row">
      <div class="slider-group">
        <label>Chunk Size (chars) <span class="slider-val" id="chunkSizeVal">150</span></label>
        <input type="range" id="chunkSize" min="60" max="400" value="150" oninput="updateChunkPreview()"/>
      </div>
      <div class="slider-group">
        <label>Overlap (chars) <span class="slider-val" id="overlapVal">20</span></label>
        <input type="range" id="overlapSize" min="0" max="80" value="20" oninput="updateChunkPreview()"/>
      </div>
    </div>

    <label>Generated Chunks (<span id="chunkCount">0</span>)</label>
    <div class="chunks-grid" id="chunksGrid"></div>

    <div class="btn-actions">
      <button class="btn btn-ghost" onclick="prevStep(1)">← Back</button>
      <button class="btn btn-primary" onclick="nextStep(1)">🔢 Embed Chunks →</button>
    </div>
  </div>

  <!-- STEP 3: Embedding -->
  <div class="card" id="step-2">
    <div class="card-header">
      <div class="card-title-block">
        <div class="card-phase">03 / 08 · INGESTION PHASE</div>
        <div class="card-title">🔢 Embedding</div>
        <div class="card-desc">// Transform text into dense vector representations</div>
      </div>
      <div class="step-badge"><div class="step-num">03</div><div class="step-total">of 08</div></div>
    </div>

    <div class="info-tag">⚡ Simulating 16-dim semantic embeddings via TF-IDF-inspired hashing</div>

    <label>Chunk Vectors (16 dimensions each)</label>
    <div class="vector-grid" id="vectorGrid"></div>

    <div class="btn-actions">
      <button class="btn btn-ghost" onclick="prevStep(2)">← Back</button>
      <button class="btn btn-primary" onclick="nextStep(2)">🗄️ Store Vectors →</button>
    </div>
  </div>

  <!-- STEP 4: Vector Store -->
  <div class="card" id="step-3">
    <div class="card-header">
      <div class="card-title-block">
        <div class="card-phase">04 / 08 · INGESTION PHASE</div>
        <div class="card-title">🗄️ Vector Store</div>
        <div class="card-desc">// Indexed database ready for similarity search</div>
      </div>
      <div class="step-badge"><div class="step-num">04</div><div class="step-total">of 08</div></div>
    </div>

    <div class="success-banner">✅ <span id="vectorStoreMsg">0 vectors indexed and ready for retrieval</span></div>

    <label>Indexed Entries</label>
    <div class="chunks-grid" id="storeGrid"></div>

    <div class="btn-actions">
      <button class="btn btn-ghost" onclick="prevStep(3)">← Back</button>
      <button class="btn btn-primary" onclick="nextStep(3)">💬 Enter a Query →</button>
    </div>
  </div>

  <!-- STEP 5: Query -->
  <div class="card" id="step-4">
    <div class="card-header">
      <div class="card-title-block">
        <div class="card-phase">05 / 08 · QUERY PHASE</div>
        <div class="card-title">💬 User Query</div>
        <div class="card-desc">// The question gets embedded into the same vector space</div>
      </div>
      <div class="step-badge"><div class="step-num">05</div><div class="step-total">of 08</div></div>
    </div>

    <label>Ask a Question</label>
    <textarea id="userQuery" rows="3" placeholder="e.g. How does RAG reduce hallucinations?"></textarea>

    <label style="margin-top:16px;">Try a Sample Query</label>
    <div class="sample-pills">
      <span class="sample-pill" onclick="setSample(this)">How does RAG use embeddings?</span>
      <span class="sample-pill" onclick="setSample(this)">What is cosine similarity?</span>
      <span class="sample-pill" onclick="setSample(this)">How are hallucinations reduced?</span>
      <span class="sample-pill" onclick="setSample(this)">What is vector search?</span>
      <span class="sample-pill" onclick="setSample(this)">How do embeddings work?</span>
    </div>

    <div id="queryTokens" class="hidden">
      <label style="margin-top:16px;">Query Tokens</label>
      <div class="token-list" id="tokenList"></div>
    </div>

    <div class="btn-actions">
      <button class="btn btn-ghost" onclick="prevStep(4)">← Back</button>
      <button class="btn btn-primary" onclick="nextStep(4)">🔍 Retrieve Chunks →</button>
    </div>
  </div>

  <!-- STEP 6: Retrieval -->
  <div class="card" id="step-5">
    <div class="card-header">
      <div class="card-title-block">
        <div class="card-phase">06 / 08 · QUERY PHASE</div>
        <div class="card-title">🔍 Semantic Retrieval</div>
        <div class="card-desc">// Cosine similarity ranked results — top-K selected</div>
      </div>
      <div class="step-badge"><div class="step-num">06</div><div class="step-total">of 08</div></div>
    </div>

    <div class="info-tag">📊 Comparing query vector against all <span id="numChunksSim">0</span> chunk vectors using cosine similarity</div>

    <label>Similarity Scores (sorted by relevance)</label>
    <div class="sim-list" id="simList"></div>

    <div class="btn-actions">
      <button class="btn btn-ghost" onclick="prevStep(5)">← Back</button>
      <button class="btn btn-primary" onclick="nextStep(5)">📝 Build Prompt →</button>
    </div>
  </div>

  <!-- STEP 7: Augment -->
  <div class="card" id="step-6">
    <div class="card-header">
      <div class="card-title-block">
        <div class="card-phase">07 / 08 · GENERATION PHASE</div>
        <div class="card-title">📝 Prompt Augmentation</div>
        <div class="card-desc">// Retrieved context + user query assembled into final prompt</div>
      </div>
      <div class="step-badge"><div class="step-num">07</div><div class="step-total">of 08</div></div>
    </div>

    <label>Augmented Prompt</label>
    <div class="prompt-box" id="promptBox"></div>

    <div class="btn-actions">
      <button class="btn btn-ghost" onclick="prevStep(6)">← Back</button>
      <button class="btn btn-primary" onclick="nextStep(6)">✨ Generate Answer →</button>
    </div>
  </div>

  <!-- STEP 8: Generate -->
  <div class="card" id="step-7">
    <div class="card-header">
      <div class="card-title-block">
        <div class="card-phase">08 / 08 · GENERATION PHASE</div>
        <div class="card-title">✨ LLM Generation</div>
        <div class="card-desc">// Grounded, citation-backed answer from retrieved context</div>
      </div>
      <div class="step-badge"><div class="step-num">08</div><div class="step-total">of 08</div></div>
    </div>

    <div id="genLoading" class="hidden" style="display:flex;align-items:center;gap:12px;margin-bottom:16px;font-family:'Space Mono',monospace;font-size:13px;color:var(--muted);">
      <div class="spinner"></div> Generating grounded response...
    </div>

    <div id="responseArea" class="hidden">
      <label>LLM Response</label>
      <div class="response-box">
        <div class="response-text" id="responseText"></div>
      </div>

      <label>Sources Used</label>
      <div class="chunks-grid" id="sourcesGrid"></div>
    </div>

    <div class="btn-actions" id="genActions">
      <button class="btn btn-ghost" onclick="prevStep(7)">← Back</button>
      <div style="display:flex;gap:10px;">
        <button class="btn btn-secondary" onclick="tryAnotherQuery()">Try Another Query</button>
        <button class="btn btn-ghost" onclick="startOver()">↺ Start Over</button>
      </div>
    </div>
  </div>

  <!-- Concept cards -->
  <div class="concepts">
    <div class="concept-card">
      <div class="concept-icon">🧬</div>
      <div class="concept-title">Embeddings</div>
      <div class="concept-body">User queries and chunks are converted into vectors that capture meaning, not just keywords. Semantically similar text produces nearby vectors.</div>
    </div>
    <div class="concept-card">
      <div class="concept-icon">📐</div>
      <div class="concept-title">Cosine Similarity</div>
      <div class="concept-body">Measures the angle between two vectors. A score of 1.0 means identical direction; 0.0 means orthogonal. Used to rank chunk relevance.</div>
    </div>
    <div class="concept-card">
      <div class="concept-icon">🔗</div>
      <div class="concept-title">Context Injection</div>
      <div class="concept-body">Retrieved chunks are prepended to the prompt, giving the LLM factual grounding before answering — reducing confabulation.</div>
    </div>
    <div class="concept-card">
      <div class="concept-icon">🛡️</div>
      <div class="concept-title">Grounded Answers</div>
      <div class="concept-body">By answering from retrieved enterprise context rather than training data alone, hallucinations are significantly reduced.</div>
    </div>
  </div>

</div>

<script>
// ─── State ──────────────────────────────────────────────────────────────────
const state = {
  docs: [
    "RAG stands for Retrieval-Augmented Generation. It retrieves relevant chunks from a vector database using semantic similarity, then uses them as context for an LLM to generate grounded answers.",
    "Embeddings are dense numerical vector representations of text. They convert words and sentences into high-dimensional vectors where semantically similar content is placed close together in vector space.",
    "Cosine similarity measures the cosine of the angle between two vectors. A score of 1.0 indicates identical direction, while 0.0 indicates perpendicular vectors with no similarity.",
    "The retrieved context chunks are appended to the user query before it is sent to the large language model. This augmented prompt gives the LLM factual grounding to answer from.",
    "Grounded responses from RAG systems reduce hallucinations because the LLM answers using provided context rather than relying solely on its parametric training data."
  ],
  chunks: [],
  embeddings: [],
  query: "",
  queryEmbedding: [],
  similarities: [],
  topK: 3,
  currentStep: 0,
  maxUnlocked: 0
};

// ─── Vocabulary for pseudo-embedding ────────────────────────────────────────
const VOCAB = ["rag","retrieval","augmented","generation","embedding","vector","cosine","similarity","chunk","document","context","llm","semantic","database","query","answer","hallucination","grounded","dense","dimension","index","search","prompt","model","text","language","knowledge","base","score","angle"];

function textToVector(text) {
  const lower = text.toLowerCase();
  const words = lower.split(/\W+/).filter(Boolean);
  const vec = new Array(16).fill(0);
  words.forEach(w => {
    let h = 0;
    for (let i = 0; i < w.length; i++) h = (h * 31 + w.charCodeAt(i)) & 0xffffffff;
    const idx = Math.abs(h) % 16;
    const idx2 = Math.abs(h >> 4) % 16;
    const val = 0.3 + (Math.abs(h) % 100) / 140;
    vec[idx] += val;
    vec[idx2] += val * 0.5;
    // semantic similarity: boost known vocab
    const vi = VOCAB.indexOf(w);
    if (vi >= 0) { vec[vi % 16] += 1.2; vec[(vi+8)%16] += 0.6; }
  });
  // normalize
  const mag = Math.sqrt(vec.reduce((s,v)=>s+v*v,0)) || 1;
  return vec.map(v => v / mag);
}

function cosineSim(a, b) {
  let dot = 0, magA = 0, magB = 0;
  for (let i = 0; i < a.length; i++) { dot += a[i]*b[i]; magA += a[i]*a[i]; magB += b[i]*b[i]; }
  return dot / (Math.sqrt(magA)*Math.sqrt(magB) || 1);
}

function chunkText(text, size, overlap) {
  const chunks = [];
  let i = 0;
  while (i < text.length) {
    chunks.push(text.slice(i, i + size));
    i += size - overlap;
    if (i + size > text.length && i < text.length) {
      chunks.push(text.slice(i));
      break;
    }
  }
  return chunks.filter(c => c.trim().length > 20);
}

// ─── Navigation ─────────────────────────────────────────────────────────────
function goToStep(n) {
  if (n > state.maxUnlocked) return;
  state.currentStep = n;
  document.querySelectorAll('.card').forEach((c,i) => {
    c.classList.toggle('active', i === n);
  });
  updateNav();
  updatePipeline();
  window.scrollTo({top:0,behavior:'smooth'});
}

function nextStep(from) {
  if (!processStep(from)) return;
  state.maxUnlocked = Math.max(state.maxUnlocked, from + 1);
  goToStep(from + 1);
}

function prevStep(from) { goToStep(from - 1); }

function updateNav() {
  document.querySelectorAll('.step-pill').forEach((p,i) => {
    p.classList.remove('active','done');
    if (i === state.currentStep) p.classList.add('active');
    else if (i < state.currentStep) p.classList.add('done');
  });
}

function updatePipeline() {
  document.querySelectorAll('.flow-node').forEach((n,i) => {
    n.classList.remove('active','done');
    const s = parseInt(n.dataset.step);
    if (s === state.currentStep) n.classList.add('active');
    else if (s < state.currentStep) n.classList.add('done');
  });
}

// ─── Process each step ──────────────────────────────────────────────────────
function processStep(step) {
  switch(step) {
    case 0: return processCorpus();
    case 1: return processChunking();
    case 2: return processEmbedding();
    case 3: return processVectorStore();
    case 4: return processQuery();
    case 5: return processRetrieval();
    case 6: return processAugment();
    case 7: return processGenerate();
    default: return true;
  }
}

// Step 1 ─────────────────────────────────────────────────────────────────────
function renderDocList() {
  const list = document.getElementById('docList');
  list.innerHTML = state.docs.map((d,i)=>`
    <div class="doc-item">
      <div class="doc-icon">📄</div>
      <div class="doc-text">${escHtml(d)}</div>
      <button class="btn btn-danger" onclick="removeDoc(${i})">✕</button>
    </div>
  `).join('');
  document.getElementById('statDocs').textContent = state.docs.length;
}

function addDoc() {
  const t = document.getElementById('newDocText').value.trim();
  if (!t) return;
  state.docs.push(t);
  document.getElementById('newDocText').value = '';
  renderDocList();
}

function removeDoc(i) {
  state.docs.splice(i,1);
  renderDocList();
}

function processCorpus() {
  if (!state.docs.length) { alert('Add at least one document.'); return false; }
  return true;
}

// Step 2 ─────────────────────────────────────────────────────────────────────
function updateChunkPreview() {
  const size = +document.getElementById('chunkSize').value;
  const overlap = +document.getElementById('overlapSize').value;
  document.getElementById('chunkSizeVal').textContent = size;
  document.getElementById('overlapVal').textContent = overlap;

  state.chunks = [];
  state.docs.forEach((doc,di) => {
    const pieces = chunkText(doc, size, overlap);
    pieces.forEach((p,pi) => state.chunks.push({ text:p, docIdx:di, chunkIdx:pi }));
  });

  document.getElementById('chunkCount').textContent = state.chunks.length;
  document.getElementById('statChunks').textContent = state.chunks.length;

  const grid = document.getElementById('chunksGrid');
  grid.innerHTML = state.chunks.map((c,i)=>`
    <div class="chunk-card">
      <div class="chunk-id">CHUNK_${String(i).padStart(3,'0')} · DOC_${c.docIdx}</div>
      <div class="chunk-text">${escHtml(c.text)}</div>
    </div>
  `).join('');
}

function processChunking() {
  updateChunkPreview();
  if (!state.chunks.length) { alert('No chunks generated. Try larger chunk size or more text.'); return false; }
  return true;
}

// Step 3 ─────────────────────────────────────────────────────────────────────
function processEmbedding() {
  state.embeddings = state.chunks.map(c => textToVector(c.text));
  const COLORS = ['#00d4ff','#7c3aed','#10b981','#f59e0b','#ef4444','#ec4899'];
  const grid = document.getElementById('vectorGrid');
  grid.innerHTML = state.embeddings.map((vec,i)=>{
    const max = Math.max(...vec);
    const bars = vec.map((v,j)=>{
      const h = Math.max(2, Math.round((v/max)*34));
      const col = COLORS[j%COLORS.length];
      return `<div class="vector-bar" style="height:${h}px;background:${col};opacity:0.8;"></div>`;
    }).join('');
    return `<div class="vector-card">
      <div class="vector-label"><span>CHUNK_${String(i).padStart(3,'0')}</span><span style="color:var(--accent3);font-size:9px;">${vec.length}d</span></div>
      <div class="vector-bars">${bars}</div>
    </div>`;
  }).join('');
  return true;
}

// Step 4 ─────────────────────────────────────────────────────────────────────
function processVectorStore() {
  document.getElementById('vectorStoreMsg').textContent = `${state.embeddings.length} vectors indexed and ready for retrieval`;
  const grid = document.getElementById('storeGrid');
  grid.innerHTML = state.chunks.map((c,i)=>`
    <div class="chunk-card">
      <div class="chunk-id">📌 CHUNK_${String(i).padStart(3,'0')} · ${c.text.length} chars</div>
      <div class="chunk-text">${escHtml(c.text.slice(0,80))}${c.text.length>80?'…':''}</div>
    </div>
  `).join('');
  return true;
}

// Step 5 ─────────────────────────────────────────────────────────────────────
function setSample(el) {
  document.getElementById('userQuery').value = el.textContent;
}

function processQuery() {
  const q = document.getElementById('userQuery').value.trim();
  if (!q) { alert('Enter a query.'); return false; }
  state.query = q;
  state.queryEmbedding = textToVector(q);

  const tokens = q.split(/\W+/).filter(Boolean);
  document.getElementById('tokenList').innerHTML = tokens.map(t=>`<span class="token">${escHtml(t)}</span>`).join('');
  document.getElementById('queryTokens').classList.remove('hidden');
  return true;
}

// Step 6 ─────────────────────────────────────────────────────────────────────
function processRetrieval() {
  document.getElementById('numChunksSim').textContent = state.chunks.length;

  state.similarities = state.chunks.map((c,i)=>({
    idx:i, text:c.text, score:cosineSim(state.queryEmbedding, state.embeddings[i])
  })).sort((a,b)=>b.score-a.score);

  const list = document.getElementById('simList');
  list.innerHTML = state.similarities.map((s,rank)=>{
    const isTop = rank < state.topK;
    const pct = Math.round(s.score * 100);
    return `<div class="sim-item ${isTop?'selected':''}">
      <div class="sim-header">
        <span class="sim-chunk">CHUNK_${String(s.idx).padStart(3,'0')} — ${escHtml(s.text.slice(0,60))}${s.text.length>60?'…':''}</span>
        <span class="sim-score">${s.score.toFixed(4)}${isTop?`<span class="topk-badge">✓ TOP-${state.topK}</span>`:''}</span>
      </div>
      <div class="sim-bar-bg"><div class="sim-bar-fill" style="width:${pct}%"></div></div>
    </div>`;
  }).join('');
  return true;
}

// Step 7 ─────────────────────────────────────────────────────────────────────
function processAugment() {
  const topChunks = state.similarities.slice(0, state.topK);
  const contextLines = topChunks.map((s,i)=>`[${i+1}] ${s.text}`).join('\n\n');

  document.getElementById('promptBox').innerHTML = `
    <div class="prompt-section">
      <div class="prompt-section-label context">■ SYSTEM INSTRUCTION</div>
      <div class="prompt-text" style="color:var(--warn);">You are a helpful AI assistant. Answer the user's question using ONLY the provided context. Cite sources using [1], [2], etc. If the answer isn't in the context, say so.</div>
    </div>
    <div class="prompt-section">
      <div class="prompt-section-label context">■ RETRIEVED CONTEXT (Top-${state.topK} chunks)</div>
      <div class="prompt-text" style="color:#c4b5fd;">${escHtml(contextLines)}</div>
    </div>
    <div class="prompt-section">
      <div class="prompt-section-label query">■ USER QUERY</div>
      <div class="prompt-text" style="color:var(--accent);">${escHtml(state.query)}</div>
    </div>
  `;
  return true;
}

// Step 8 ─────────────────────────────────────────────────────────────────────
function processGenerate() {
  document.getElementById('genLoading').style.display = 'flex';
  document.getElementById('responseArea').classList.add('hidden');

  setTimeout(()=>{
    document.getElementById('genLoading').style.display = 'none';
    document.getElementById('responseArea').classList.remove('hidden');

    const topChunks = state.similarities.slice(0, state.topK);
    const answer = generateSimulatedAnswer(state.query, topChunks);
    typeWriter(document.getElementById('responseText'), answer);

    const srcGrid = document.getElementById('sourcesGrid');
    srcGrid.innerHTML = topChunks.map((s,i)=>`
      <div class="chunk-card highlighted">
        <div class="chunk-id" style="color:var(--accent3);">SOURCE [${i+1}] · sim: ${s.score.toFixed(4)}</div>
        <div class="chunk-text">${escHtml(s.text)}</div>
      </div>
    `).join('');
  }, 1800);
  return true;
}

function generateSimulatedAnswer(query, chunks) {
  const q = query.toLowerCase();
  const sentences = [];
  chunks.forEach((c,i) => {
    const t = c.text;
    const parts = t.split(/\.\s+/);
    const lead = parts[0] || t;
    sentences.push(`${lead.trim()} <span class="citation">[${i+1}]</span>`);
  });

  let intro = "Based on the retrieved context: ";
  if (q.includes('hallucin')) intro = "Regarding hallucinations: ";
  else if (q.includes('embed')) intro = "On the topic of embeddings: ";
  else if (q.includes('cosine') || q.includes('similar')) intro = "Regarding cosine similarity: ";
  else if (q.includes('vector')) intro = "About vector search: ";
  else if (q.includes('rag') || q.includes('retrieval')) intro = "About RAG and retrieval: ";

  return intro + sentences.join('. ') + '.';
}

function typeWriter(el, html) {
  el.innerHTML = '';
  const temp = document.createElement('div');
  temp.innerHTML = html;
  const plain = temp.innerHTML;
  const cursor = '<span class="typing-cursor"></span>';
  let i = 0;
  const chars = plain;

  function tick() {
    i += 3;
    el.innerHTML = chars.slice(0, i) + cursor;
    if (i < chars.length) setTimeout(tick, 14);
    else el.innerHTML = chars;
  }
  tick();
}

// ─── Other ───────────────────────────────────────────────────────────────────
function tryAnotherQuery() {
  state.maxUnlocked = Math.max(state.maxUnlocked, 4);
  goToStep(4);
}

function startOver() {
  state.chunks = [];
  state.embeddings = [];
  state.query = '';
  state.queryEmbedding = [];
  state.similarities = [];
  state.maxUnlocked = 0;
  state.currentStep = 0;
  goToStep(0);
  renderDocList();
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ─── Init ────────────────────────────────────────────────────────────────────
renderDocList();
updateChunkPreview();
updateNav();
updatePipeline();

// wire sliders
document.getElementById('chunkSize').addEventListener('input', () => {
  document.getElementById('chunkSizeVal').textContent = document.getElementById('chunkSize').value;
});
document.getElementById('overlapSize').addEventListener('input', () => {
  document.getElementById('overlapVal').textContent = document.getElementById('overlapSize').value;
});
</script>
</body>
</html>
